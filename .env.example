DATABASE_URL=postgresql+psycopg://apc:apc@postgres:5432/apc
# Postgres baglanti havuzu (tek uvicorn sureci icin yeterli)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
APP_ENV=development
# Gelistirme varsayilani. APP_ENV=production iken ZORUNLU ve en az 32 karakter;
# "gelistirme-anahtari" kabul edilmez.
SECRET_KEY=gelistirme-anahtari
# APP_ENV=production iken /docs, /redoc ve /openapi.json otomatik kapanir.

# Active Directory / LDAP
LDAP_SUNUCU=dc01.sirket.local
# Birden fazla DC: virgulle ayirin (or. dc01.sirket.local,dc02.sirket.local)
LDAP_PORT=
LDAP_DOMAIN=sirket.local
LDAP_ARAMA_TABANI=DC=sirket,DC=local

# kapali | starttls | ldaps -- APP_ENV=production iken 'kapali' KABUL EDILMEZ.
LDAP_TLS_MODU=ldaps
# starttls/ldaps icin CA sertifikasi (Windows DC'den export edilen Base-64 PEM).
# APP_ENV=production iken ZORUNLU — yoksa uygulama acilmaz (CERT_NONE yasak, BUG-10).
LDAP_CA_SERTIFIKA_DOSYASI=config/ad-ca.pem

# AD grubu -> uygulama izni eslemesi. Varsayilan: config/yetki_haritasi.json
YETKI_HARITASI_DOSYASI=

# Istege bagli: Cloudflare Tunnel (domain ile internete acmak icin).
# Token'i Cloudflare Zero Trust > Networks > Tunnels ekranindan alin.
# CLOUDFLARE_TUNNEL_TOKEN=

# Vekil (reverse proxy) arkasindaysaniz X-Forwarded-For'a guvenmek icin
# vekilin peer IP'sini yazin (or. 10.0.0.2). Bos = XFF yok sayilir (BUG-16).
# Gelistirmede genelde bos birakin. Tum vekillere guvenmek icin: *
# FORWARDED_ALLOW_IPS=

# Gunluk pg_dump (opsiyonel): docker compose --profile backup up -d
# BACKUP_KEEP_DAYS=14

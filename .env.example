DATABASE_URL=postgresql+psycopg://apc:apc@postgres:5432/apc
APP_ENV=development
SECRET_KEY=gelistirme-anahtari

# Active Directory / LDAP
LDAP_SUNUCU=dc01.sirket.local
LDAP_PORT=
LDAP_DOMAIN=sirket.local
LDAP_ARAMA_TABANI=DC=sirket,DC=local

# kapali | starttls | ldaps -- APP_ENV=production iken 'kapali' KABUL EDILMEZ.
LDAP_TLS_MODU=ldaps
# starttls/ldaps icin CA sertifikasi (Windows DC'den export edilen Base-64 PEM):
LDAP_CA_SERTIFIKA_DOSYASI=config/ad-ca.pem

# AD grubu -> uygulama izni eslemesi. Varsayilan: config/yetki_haritasi.json
YETKI_HARITASI_DOSYASI=

# Istege bagli: Cloudflare Tunnel (domain ile internete acmak icin).
# Token'i Cloudflare Zero Trust > Networks > Tunnels ekranindan alin.
# CLOUDFLARE_TUNNEL_TOKEN=
